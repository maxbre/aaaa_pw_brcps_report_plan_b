```{dot}
//| fig-width: 14
//| fig-height: 7.2

//| out-height: "0.7\\textheight"
//| out-width: "!\\textheight"

digraph VIS {

  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad=0.05,
    nodesep=0.38,
    ranksep=0.38,
    splines=ortho
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=16,
    fixedsize=true,
    margin="0.08,0.05",
    penwidth=2
  ];

  edge [
    color="#7D7D7D",
    penwidth=2,
    arrowsize=0.7
  ];

  A [
    label="NO₂ per sezione",
    width=2.20,
    height=0.70,
    fillcolor="#FFFFFF",
    color="#7D7D7D",
    fontcolor="#393D3F"
  ];

  B [
    label="Popolazione 30+",
    width=2.20,
    height=0.70,
    fillcolor="#FFFFFF",
    color="#7D7D7D",
    fontcolor="#393D3F"
  ];

  C [
    label="Mortalità basale",
    width=2.20,
    height=0.70,
    fillcolor="#FFFFFF",
    color="#7D7D7D",
    fontcolor="#393D3F"
  ];

  D [
    label="RR₁₀ OMS: 1,05",
    width=2.20,
    height=0.70,
    fillcolor="#FFFFFF",
    color="#7D7D7D",
    fontcolor="#393D3F"
  ];

  E [
    label="Eccedenza esposizione\nΔC = max(C − 10, 0)",
    width=3.20,
    height=0.78,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];

  F [
    label="Casi attesi\nE = N × B",
    width=3.20,
    height=0.78,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];

  G [
    label="Frazione attribuibile\nAF = 1 − exp(−βΔC)",
    width=3.20,
    height=0.78,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];

  H [
    label="Casi attribuibili per sezione\nAC = E × AF",
    width=3.40,
    height=0.78,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];

  I [
    label="Aggregazione",
    width=3.40,
    height=0.78,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];

  J [
    label="Stima puntuale 2025",
    width=3.25,
    height=0.82,
    fontsize=18,
    fillcolor="#AA0004",
    color="#850205",
    fontcolor="#FFFFFF"
  ];

  K [
    label="Simulazione 2025\n (incertezza RR)",
    width=3.25,
    height=0.82,
    fontsize=18,
    fillcolor="#AA0004",
    color="#850205",
    fontcolor="#FFFFFF"
  ];

  L [
    label="Simulazione sorica\n 2019–2025",
    width=3.25,
    height=0.82,
    fontsize=18,
    fillcolor="#AA0004",
    color="#850205",
    fontcolor="#FFFFFF"
  ];

 M [
    label=""Ripetizione Monte Carlo\ndel calcolo e aggregazione",
    width=3.25,
    height=0.82,
    fillcolor="#FFFFFF",
    color="#AA0004",
    fontcolor="#393D3F"
  ];
  
  { rank=same; A; B; C; D; }
  { rank=same; E; F;}
  { rank=same; I; M; }
  { rank=same; J; K; L;}

  A -> E;
  B -> F;
  C -> F;
  D -> G;
  E -> G;
  F -> H;
  G -> H;
  H -> I;
  H -> M;
  I -> J;
  M -> L;
  M -> K;
  
/* trick: impone l’ordine orizzontale */
J -> K [style=invis, weight=100];
K -> L [style=invis, weight=100];
}
```


